# 실제 값은 여기 적지 않는다. 로컬은 .env.local, 배포는 Vercel 프로젝트 환경변수에 넣는다.

# DB 접속 문자열. 없으면 로컬 PGlite(.pglite)로 자동 폴백한다. 배포에는 반드시 필요.
DATABASE_URL=

# 세션 쿠키·근태 QR 토큰 서명 키. 없으면 접속 문자열에서 파생한다(src/lib/auth.ts).
SESSION_SECRET=

# 마스터 계정 최초 생성 시에만 쓰는 시드 비밀번호 (src/lib/bootstrap.ts).
# 계정이 이미 있으면 무시된다 — 비밀번호를 덮어쓰지 않는다.
# 배포에서 값이 비어 있으면 해당 계정을 만들지 않고 건너뛴다(고정값 폴백 없음).
MASTER_CTO_PIN=
MASTER_IRIUM_PIN=

# 결석 처리 크론 인증 (src/app/api/cron/unexcused-absences).
CRON_SECRET=

# 문자 발송 큐(알리고). 웹앱은 큐에 넣기만 하고, 등록된 고정 IP를 가진 원내 기기에서 도는
# scripts/sms-worker.mjs 가 이 값들로 큐를 가져가 실제로 알리고를 부른다 (src/lib/sms.ts,
# src/app/api/sms-worker/route.ts). 웹앱(Vercel)에는 SMS_WORKER_SECRET 만 있으면 되고, 나머지
# ALIGO_* 값은 발송기를 돌리는 원내 기기 쪽에만 필요하다(웹앱 서버는 알리고를 직접 부르지 않는다).

# 웹앱 API 라우트(/api/sms-worker)와 발송기 스크립트가 공유하는 비밀. 로그인 세션이 아니라
# 이 값으로만 그 라우트를 연다 — 미설정이면 로컬은 고정 개발용 값으로 폴백하고, 배포는 거부한다.
SMS_WORKER_SECRET=

# 알리고 발송 API(https://apis.aligo.in/send/) 인증·발신정보 — 발송기를 돌리는 원내 기기에만 설정.
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=

# 발송기가 웹앱을 찾아갈 주소. 비우면 http://localhost:3000 으로 폴백(로컬 개발용).
STUDYCUBE_API_BASE=

# 기본은 항상 테스트 모드(실제 발송 안 함, 알리고가 형식만 검사). 사람이 명시적으로 "true" 를
# 넣을 때만 실제 발송(과금 발생)으로 전환한다.
ALIGO_SEND_LIVE=

# 발송기 자신이 웹앱의 "찌르기"를 받을 포트(발송기 쪽에만 설정). 비우면 8787.
SMS_WORKER_PORT=

# 웹앱이 큐잉 직후 발송기를 찌를 주소(웹앱 쪽에만 설정, 예: http://<VPS 고정 IP>:8787).
# 비워두면 찌르지 않는다 — 그래도 큐잉 자체는 정상 동작하고, 발송기 쪽 5분 안전망이 대신 집어간다.
SMS_WORKER_URL=
